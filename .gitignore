# Secrets
.env

# Per-machine config (contains live account + terminal path); use config.example.json as the template
config.json
config.*.json
config.json.backup.*
# ...but the template IS tracked: Setup copies it to config.json, and the tests read it
# (no account, server or terminal path in it).
!config.example.json

# Local DB backups made before maintenance (contain live account data)
dashboard.sqlite3.bak-*

# Runtime health-alert log
health_alerts.jsonl

# Runtime state / dedup
state.json
confluence_state.json
orb_state.json
launcher_settings.json
health_watchdog.json
live_test_orb_state.json

# Databases and WAL/SHM
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# Decision / audit logs
decisions.jsonl
confluence_decisions.jsonl
orb_decisions.jsonl
logs/

# Runtime locks
*.lock
bot.runtime.lock

# Backups
backups/

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS
Thumbs.db
desktop.ini
